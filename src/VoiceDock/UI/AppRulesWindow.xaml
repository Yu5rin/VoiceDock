<Window x:Class="VoiceDock.UI.AppRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock アプリ別の設定"
        Width="660" Height="500" MinWidth="520" MinHeight="340"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="アプリ別の設定" FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Style="{StaticResource SubText}" Margin="0,4,0,10"
                   Text="特定のアプリだけ、入力方式と「改行」の送り方を変えられます。「既定に従う」にした項目は、設定画面の既定の値で動作します。&#10;・直接キー入力で文字が入らないアプリ（一部の業務システム、リモートデスクトップ等）→ 入力方式を「クリップボード貼り付け」&#10;・Excel のセル内で改行したい → 改行を「Alt+Enter」　・Shift+Enter で改行できないアプリ → 改行を「Enter」"/>

        <!-- 追加行: 入力先として使ったことのあるアプリから選ぶ / 手入力もできる -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="AppCombo" IsEditable="True"
                      ToolTip="プロセス名（拡張子なし）。例: notepad, chrome, EXCEL, Teams"/>
            <Button Grid.Column="1" Content="追加" Margin="8,0,0,0" Click="Add_Click"/>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource SubText}" Margin="0,2,0,8"
                   Text="一覧の候補は、これまでに音声入力で文字を入れたアプリです。"/>

        <Grid Grid.Row="4">
            <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False"
                  SelectionUnit="FullRow" SelectionMode="Extended"
                  Background="{StaticResource PanelBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="アプリ（プロセス名）" Binding="{Binding AppName}" Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="入力方式" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedIndex="{Binding MethodIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="2" BorderThickness="0">
                                    <ComboBoxItem Content="既定に従う"/>
                                    <ComboBoxItem Content="直接キー入力"/>
                                    <ComboBoxItem Content="クリップボード貼り付け"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="改行" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedIndex="{Binding NewlineIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="2" BorderThickness="0">
                                    <ComboBoxItem Content="既定に従う"/>
                                    <ComboBoxItem Content="Shift+Enter"/>
                                    <ComboBoxItem Content="Enter"/>
                                    <ComboBoxItem Content="Alt+Enter"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                       TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                       Text="アプリ別の設定はまだありません。&#10;通常はこのままで問題ありません。特定のアプリだけ動きを変えたいときに、上の欄からそのアプリを追加してください。"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="選択行を削除" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</Window>
