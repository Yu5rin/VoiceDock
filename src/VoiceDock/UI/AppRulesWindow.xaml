<Window x:Class="VoiceDock.UI.AppRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock のアプリ別の設定"
        Width="680" Height="540" MinWidth="540" MinHeight="380"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="アプリ別の設定" Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource SubText}" Margin="0,4,0,14"
                   Text="特定のアプリだけ、文字の入れ方と改行のキーを変えられます。「共通の設定に従う」のままの項目は、設定画面で選んだとおりに動きます。&#10;・文字が入らないアプリ（一部の業務システム、リモートデスクトップなど）→ 文字の入れ方を「貼り付けで入れる」&#10;・Excel のセルの中で改行したい → 改行を「Alt+Enter」　・Shift+Enter で改行できないアプリ → 改行を「Enter」"/>

        <!-- 追加行: 入力先として使ったことのあるアプリから選ぶ / 手入力もできる -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="AppCombo" IsEditable="True"
                      AutomationProperties.Name="追加するアプリ"
                      KeyDown="AppCombo_KeyDown"
                      ToolTip="プロセス名（拡張子なし）。例: notepad, chrome, EXCEL, Teams"/>
            <Button Grid.Column="1" Content="追加" MinWidth="88" Margin="8,0,0,0" Click="Add_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="StatusText" Style="{StaticResource SubText}" Margin="0,2,0,8"
                   Text="▼ を押すと、これまでに音声入力で文字を入れたアプリから選べます。名前（例: EXCEL）を直接入力することもできます。"/>

        <Grid Grid.Row="4">
            <DataGrid x:Name="Grid"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserReorderColumns="False"
                  PreviewKeyDown="Grid_PreviewKeyDown" SelectionChanged="Grid_SelectionChanged"
                  SelectionUnit="FullRow" SelectionMode="Extended"
                  Background="{StaticResource PanelBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="アプリ（プロセス名）" Binding="{Binding AppName}" Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="文字の入れ方" Width="190">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedIndex="{Binding MethodIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,2" AutomationProperties.Name="文字の入れ方">
                                    <ComboBoxItem Content="共通の設定に従う"/>
                                    <ComboBoxItem Content="キー入力として送る"/>
                                    <ComboBoxItem Content="貼り付けで入れる"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="改行のキー" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedIndex="{Binding NewlineIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,2" AutomationProperties.Name="改行のキー">
                                    <ComboBoxItem Content="共通の設定に従う"/>
                                    <ComboBoxItem Content="Shift+Enter"/>
                                    <ComboBoxItem Content="Enter"/>
                                    <ComboBoxItem Content="Alt+Enter"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                       TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"
                       Text="アプリ別の設定はまだありません。&#10;ふつうはこのままで使えます。特定のアプリだけ動きを変えたいときに、上の欄からそのアプリを追加してください。"/>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="DeleteButton" Content="選んだ行を削除" Click="Delete_Click" IsEnabled="False"
                    Style="{StaticResource DangerButton}" ToolTip="Delete キーでも削除できます"/>
            <Button DockPanel.Dock="Right" Content="閉じる" MinWidth="88" IsCancel="True" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
