<Window x:Class="VoiceDock.UI.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock の動作チェック"
        Width="620" Height="680" MinWidth="500" MinHeight="440"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="動作チェック" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource SubText}" Margin="0,4,0,14"
                       Text="「文字が入らない」「認識しない」ときに、どこに原因があるかを確かめます。⚠ の付いた項目が、原因の候補です。"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- VoiceDock の状態 -->
                <Border Style="{StaticResource FormPanel}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="最新の状態にする" Click="Refresh_Click"/>
                            <TextBlock Text="VoiceDock の状態" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel x:Name="StatusPanel" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 入力先のアプリ -->
                <Border Style="{StaticResource FormPanel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="入力先のアプリを調べる" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,10"
                                   Text="ボタンを押したら 5 秒以内に、調べたいアプリの入力欄をクリックしてください。そのアプリでの文字の入れ方・改行のキー・IME の状態を調べます。"/>
                        <DockPanel>
                            <Button x:Name="ProbeButton" DockPanel.Dock="Left" Content="5 秒後に調べる" Click="Probe_Click"
                                    VerticalAlignment="Top"/>
                            <!-- 長い案内が切れないよう、折り返して表示する -->
                            <TextBlock x:Name="ProbeCountdown" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource WarnText}"/>
                        </DockPanel>
                        <StackPanel x:Name="ProbePanel" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- テスト入力 -->
                <Border Style="{StaticResource FormPanel}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="テスト入力" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource SubText}" Margin="0,0,0,10"
                                   Text="ボタンを押したら 5 秒以内に、試したいアプリの入力欄をクリックしてください。音声入力と同じ方法で「VoiceDock のテスト入力です。123 ABC」と入力します。文字が入らない・崩れるときは、「アプリ別の設定」で、そのアプリの文字の入れ方を変えてみてください。"/>
                        <DockPanel>
                            <Button x:Name="TestButton" DockPanel.Dock="Left" Content="5 秒後にテスト入力" Click="Test_Click"
                                    VerticalAlignment="Top"/>
                            <TextBlock x:Name="TestCountdown" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource WarnText}"/>
                        </DockPanel>
                        <TextBlock x:Name="TestResult" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button Content="結果をコピー" Margin="0,0,8,0" Click="Copy_Click"
                    ToolTip="問い合わせや調査のときに貼り付けられるよう、この画面の内容を文字でコピーします（音声入力の内容は含みません）"/>
            <Button Content="ログ…" Margin="0,0,8,0" Click="ShowLog_Click"/>
            <Button DockPanel.Dock="Right" Content="閉じる" MinWidth="88" IsCancel="True" Click="Close_Click"/>
        </DockPanel>
    </Grid>
</Window>
