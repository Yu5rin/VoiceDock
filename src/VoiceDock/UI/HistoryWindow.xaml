<Window x:Class="VoiceDock.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VoiceDock.UI"
        Title="VoiceDock の認識履歴"
        Width="680" Height="580" MinWidth="520" MinHeight="400"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <ui:OneLineConverter x:Key="OneLine"/>
    </Window.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="認識履歴" Style="{StaticResource PageTitle}" Margin="0,0,0,12"/>

        <TabControl Grid.Row="1" x:Name="Tabs">
            <!-- ================= 認識履歴 ================= -->
            <TabItem Header="入力した文章">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SubText}" Margin="0,0,0,10"
                               Text="新しい順に、最大 200 件を表示します。入力欄が無くて入らなかった文章もここに残るので、コピーして使えます。履歴は VoiceDock を終了すると消え、ファイルには保存しません。"/>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="Grid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                                  SelectionUnit="FullRow" SelectionMode="Single"
                                  MouseDoubleClick="Grid_MouseDoubleClick"
                                  PreviewKeyDown="Grid_PreviewKeyDown"
                                  SelectionChanged="Grid_SelectionChanged"
                                  Background="{StaticResource PanelBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="時刻" Binding="{Binding TimeLabel}" Width="96"/>
                                <DataGridTextColumn Header="入力先" Binding="{Binding AppLabel}" Width="120"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Text, Converter={StaticResource OneLine}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource SubText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                                   TextAlignment="Center" IsHitTestVisible="False"
                                   Text="まだ履歴がありません。音声入力を行うとここに表示されます。"/>
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="ReinjectButton" Content="もう一度入力" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,4" Click="Reinject_Click"
                                ToolTip="最後に音声入力したアプリに切り替えて入力します（行のダブルクリックでも入力できます）"/>
                        <Button x:Name="CopyButton" Content="コピー" Margin="0,0,8,4" Click="Copy_Click"
                                ToolTip="Ctrl+C でもコピーできます"/>
                        <Button x:Name="RegisterButton" Content="辞書に登録…" Margin="0,0,8,4" Click="Register_Click"
                                ToolTip="この文章を読みの欄に入れた状態で、辞書を開きます"/>
                        <Button x:Name="ClearButton" Content="履歴をすべて消す…" Margin="0,0,8,4" Click="Clear_Click"
                                Style="{StaticResource DangerButton}"
                                ToolTip="認識履歴と、よく取り消す文章の集計をすべて消します"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="3" x:Name="TargetText" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                </Grid>
            </TabItem>

            <!-- ================= よく取り消す文章 ================= -->
            <TabItem Header="よく取り消す文章">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SubText}" Margin="0,0,0,10"
                               Text="音声入力の後に取り消した文章を、回数の多い順に表示します。何度も取り消している文章には、誤って認識されやすい言葉が含まれているかもしれません。［辞書に登録］で、その部分だけを残して正しい表記を登録してください。集計は VoiceDock を終了すると消えます。"/>

                    <Grid Grid.Row="1">
                        <DataGrid x:Name="UndoneGrid"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                                  SelectionUnit="FullRow" SelectionMode="Single"
                                  MouseDoubleClick="UndoneGrid_MouseDoubleClick"
                                  PreviewKeyDown="UndoneGrid_PreviewKeyDown"
                                  SelectionChanged="UndoneGrid_SelectionChanged"
                                  Background="{StaticResource PanelBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="回数" Binding="{Binding Count}" Width="56"/>
                                <DataGridTextColumn Header="最後に取り消した時刻" Binding="{Binding LastTime, StringFormat=HH:mm:ss}" Width="140"/>
                                <DataGridTextColumn Header="内容" Binding="{Binding Text, Converter={StaticResource OneLine}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="UndoneEmptyText" Style="{StaticResource SubText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                                   TextAlignment="Center" IsHitTestVisible="False"
                                   Text="まだ取り消した文章はありません。&#10;「とりけし」「戻して」と話すか、ホットキーで取り消すと、ここに集計されます。"/>
                    </Grid>

                    <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="UndoneRegisterButton" Content="辞書に登録…" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,4" Click="UndoneRegister_Click"
                                ToolTip="この文章を読みの欄に入れた状態で、辞書を開きます（行のダブルクリックでも開けます）"/>
                        <Button x:Name="UndoneCopyButton" Content="コピー" Margin="0,0,8,4" Click="UndoneCopy_Click"
                                ToolTip="Ctrl+C でもコピーできます"/>
                    </WrapPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
