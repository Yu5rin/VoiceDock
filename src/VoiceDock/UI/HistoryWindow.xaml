<Window x:Class="VoiceDock.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VoiceDock.UI"
        Title="VoiceDock 認識履歴"
        Width="640" Height="540" MinWidth="480" MinHeight="360"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Window.Resources>
        <ui:OneLineConverter x:Key="OneLine"/>
    </Window.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="認識履歴" FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Style="{StaticResource SubText}" Margin="0,4,0,12"
                   Text="直近の音声入力の結果です（新しい順・最大 200 件）。入力欄が無くて入らなかった文章もここに残ります。履歴はアプリを終了すると消え、ファイルには保存しません。"/>

        <Grid Grid.Row="2">
            <DataGrid x:Name="Grid"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False"
                      SelectionUnit="FullRow" SelectionMode="Single"
                      MouseDoubleClick="Grid_MouseDoubleClick"
                      SelectionChanged="Grid_SelectionChanged"
                      Background="{StaticResource PanelBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="時刻" Binding="{Binding Time, StringFormat=HH:mm:ss}" Width="80"/>
                    <DataGridTextColumn Header="入力先" Binding="{Binding AppLabel}" Width="120"/>
                    <DataGridTextColumn Header="内容" Binding="{Binding Text, Converter={StaticResource OneLine}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                       TextAlignment="Center" IsHitTestVisible="False"
                       Text="まだ履歴がありません。音声入力を行うとここに表示されます。"/>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="ReinjectButton" Content="もう一度入力" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,4" Click="Reinject_Click"
                    ToolTip="最後に音声入力したアプリに切り替えて入力します（行をダブルクリックでも可）"/>
            <Button x:Name="CopyButton" Content="コピー" Margin="0,0,8,4" Click="Copy_Click"/>
            <Button x:Name="RegisterButton" Content="辞書に登録" Margin="0,0,8,4" Click="Register_Click"
                    ToolTip="この文章を読みの欄に入れた状態で辞書管理を開きます"/>
            <Button Content="履歴を消去" Margin="0,0,8,4" Click="Clear_Click"/>
        </WrapPanel>
        <TextBlock Grid.Row="4" x:Name="TargetText" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
    </Grid>
</Window>
