<Window x:Class="VoiceDock.UI.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock ログ"
        Width="680" Height="500" MinWidth="480" MinHeight="320"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ログ" FontSize="18" FontWeight="Bold"/>
        <Grid Grid.Row="1" Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SubText}" VerticalAlignment="Center"
                       Text="エラー・動作ログと認識テキストの履歴（ファイルには 30 日分保存）"/>
            <ComboBox Grid.Column="1" x:Name="FilterCombo" Width="150"
                      SelectionChanged="FilterCombo_SelectionChanged"/>
        </Grid>

        <ListBox Grid.Row="2" x:Name="LogList"
                 FontFamily="Consolas, Yu Gothic UI"
                 SelectionMode="Extended"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="選択行をコピー" Click="CopySelected_Click"/>
            <Button Content="ログフォルダを開く" Margin="8,0,0,0" Click="OpenFolder_Click"/>
        </StackPanel>
    </Grid>
</Window>
