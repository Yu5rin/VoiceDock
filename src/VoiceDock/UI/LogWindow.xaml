<Window x:Class="VoiceDock.UI.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock のログ"
        Width="760" Height="540" MinWidth="520" MinHeight="340"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="ログ" Style="{StaticResource PageTitle}"/>
        <Grid Grid.Row="1" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource SubText}" VerticalAlignment="Center"
                       Text="動作の記録です（ファイルには 30 日分を残します）。うまく動かないときの手がかりになります。"/>
            <ComboBox Grid.Column="1" x:Name="FilterCombo" Width="170" Margin="12,0,0,0"
                      AutomationProperties.Name="表示する種類"
                      SelectionChanged="FilterCombo_SelectionChanged"/>
        </Grid>

        <Grid Grid.Row="2">
            <ListBox x:Name="LogList"
                     FontFamily="Consolas, Yu Gothic UI"
                     SelectionMode="Extended"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"/>
            <!-- 0 件のときに何も出ないと不安になるため、状態を明示する -->
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Visibility="Collapsed"
                       Text="表示できるログがありません。"/>
        </Grid>

        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="コピー" Margin="0,0,8,4" Click="CopySelected_Click"
                    ToolTip="選んだ行をコピーします。何も選んでいなければ、表示中のすべての行をコピーします（問い合わせに貼り付けるときに使えます）"/>
            <Button Content="ログの保存先を開く" Margin="0,0,8,4" Click="OpenFolder_Click"/>
            <Button Content="ログをすべて消す…" Margin="0,0,8,4" Click="DeleteLogs_Click"
                    Style="{StaticResource DangerButton}"/>
        </WrapPanel>
    </Grid>
</Window>
