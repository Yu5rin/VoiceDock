<Window x:Class="VoiceDock.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock の設定"
        Width="640" Height="680" MinWidth="560" MinHeight="460"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <!-- 項目が多いため、使う場面ごとにタブで分ける。値の変更は即時反映（保存ボタンなし）。
         各項目は「名前 → 選ぶ部品 → 短い説明」の順に並べる -->
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="設定" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="変えた内容は、その場で反映・保存されます" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="Tabs">

            <!-- ================= 音声入力 ================= -->
            <TabItem Header="音声入力">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,14,8">
                    <StackPanel>

                        <TextBlock Text="ホットキー" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="音声入力の開始・停止" Style="{StaticResource ItemLabel}"/>
                        <DockPanel>
                            <Button x:Name="HotkeyChangeButton" DockPanel.Dock="Right" Content="変更…" Margin="8,0,0,0"
                                    Click="HotkeyChange_Click"
                                    AutomationProperties.Name="音声入力のホットキーを変更"/>
                            <TextBox x:Name="HotkeyBox" IsReadOnly="True" IsTabStop="False" Cursor="Hand"
                                     AutomationProperties.Name="音声入力のホットキー"
                                     PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
                        </DockPanel>
                        <TextBlock x:Name="HotkeyWarning" Style="{StaticResource WarnText}"
                                   Margin="0,6,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="「変更…」を押してから、使いたいキーの組み合わせを押してください（例: Ctrl+Space、F9）"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <TextBlock Text="ホットキーの動作" Style="{StaticResource ItemLabel}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="HotkeyModeCombo" SelectionChanged="HotkeyModeCombo_SelectionChanged"
                                  AutomationProperties.Name="ホットキーの動作"/>
                        <TextBlock Text="「押している間だけ」は、短いひと言を入れたいときに向いています"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="マイクと言語" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="マイク" Style="{StaticResource ItemLabel}"/>
                        <DockPanel>
                            <Button x:Name="RefreshMicButton" DockPanel.Dock="Right" Content="一覧を更新" Margin="8,0,0,0"
                                    Click="RefreshMic_Click"
                                    ToolTip="つないだマイクが一覧に無いときに押してください（名前を調べるため、マイクを一瞬だけ開きます）"/>
                            <ComboBox x:Name="MicCombo" SelectionChanged="MicCombo_SelectionChanged"
                                      AutomationProperties.Name="マイク"/>
                        </DockPanel>
                        <TextBlock x:Name="MicWarning" Style="{StaticResource WarnText}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="MicrophoneText" Style="{StaticResource SubText}" Margin="0,6,0,0"/>
                        <TextBlock Text="「Windows の既定のマイク」では、Windows の 設定 → システム → サウンド → 入力 で選んだマイクを使います。マイクを個別に選ぶには新しい Edge / Chrome が必要で、古い版では既定のマイクで認識します"
                                   Style="{StaticResource SubText}" Margin="0,4,0,0"/>

                        <TextBlock Text="認識言語" Style="{StaticResource ItemLabel}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged"
                                  AutomationProperties.Name="認識言語"/>
                        <TextBlock Text="トレイメニューからも切り替えられます。音声入力中に変えても、その場で切り替わります"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="音声入力中の動き" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="話さないときに自動で止めるまでの時間" Style="{StaticResource ItemLabel}"/>
                        <ComboBox x:Name="SilenceCombo" SelectionChanged="SilenceCombo_SelectionChanged"
                                  AutomationProperties.Name="話さないときに自動で止めるまでの時間"/>
                        <TextBlock Text="止め忘れて、周りの会話を拾ってしまうのを防ぎます"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <TextBlock Text="音声入力中の表示の位置" Style="{StaticResource ItemLabel}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="OverlayCombo" SelectionChanged="OverlayCombo_SelectionChanged"
                                  AutomationProperties.Name="音声入力中の表示の位置"/>
                        <TextBlock Text="音量の波形と、認識途中の文字を出す場所です。チャットの入力欄と重なるときは、上や右下に変えられます"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <CheckBox x:Name="SoundCheck" Content="開始・停止のときに音を鳴らす" Margin="0,16,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 文字入力 ================= -->
            <TabItem Header="文字入力">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,14,8">
                    <StackPanel>

                        <TextBlock Text="文字の入れ方" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="文字の入れ方" Style="{StaticResource ItemLabel}"/>
                        <ComboBox x:Name="InputMethodCombo" SelectionChanged="InputMethodCombo_SelectionChanged"
                                  AutomationProperties.Name="文字の入れ方"/>
                        <TextBlock Text="ふつうは「キー入力として送る」のままで使えます。文字が入らないアプリでは「貼り付けで入れる」をお試しください（元のクリップボードの内容は自動で戻します）"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <TextBlock Text="「改行」と話したときに送るキー" Style="{StaticResource ItemLabel}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="NewlineCombo" SelectionChanged="NewlineCombo_SelectionChanged"
                                  AutomationProperties.Name="改行と話したときに送るキー"/>
                        <TextBlock Text="Shift+Enter は、Enter が「送信」になるチャット（Slack・Teams など）でも誤って送信しません"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <TextBlock Text="アプリごとに変える" Style="{StaticResource ItemLabel}" Margin="0,16,0,6"/>
                        <Button Content="アプリ別の設定…" HorizontalAlignment="Left" Click="OpenAppRules_Click"/>
                        <TextBlock Text="特定のアプリだけ、文字の入れ方や改行のキーを変えられます（例: Excel は Alt+Enter）"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="直前の入力の取り消し" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="UndoCheck" Content="取り消しを使う（「とりけし」「戻して」と話すか、ホットキーで）"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="直前に入力した分だけを消します。誤認識のやり直しに使います"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <StackPanel x:Name="UndoOptions" Margin="27,12,0,0">
                            <TextBlock Text="取り消しのホットキー" Style="{StaticResource ItemLabel}"/>
                            <DockPanel>
                                <Button x:Name="UndoHotkeyChangeButton" DockPanel.Dock="Right" Content="変更…" Margin="8,0,0,0"
                                        Click="UndoHotkeyChange_Click"
                                        AutomationProperties.Name="取り消しのホットキーを変更"/>
                                <TextBox x:Name="UndoHotkeyBox" IsReadOnly="True" IsTabStop="False" Cursor="Hand"
                                         AutomationProperties.Name="取り消しのホットキー"
                                         PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                         LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"/>
                            </DockPanel>
                            <TextBlock x:Name="UndoHotkeyWarning" Style="{StaticResource WarnText}"
                                       Margin="0,6,0,0" Visibility="Collapsed"/>

                            <CheckBox x:Name="SuggestUndoCheck" Content="同じ文章を何度も取り消したら、辞書への登録を勧める" Margin="0,14,0,0"
                                      Checked="Option_Changed" Unchecked="Option_Changed"
                                      ToolTip="同じ文章を 2 回取り消すと通知します。通知をクリックすると、その文章を入れた状態で辞書が開きます。取り消した文章は、認識履歴の「よく取り消す文章」でも確認できます（メモリにだけ持ち、ファイルには保存しません）"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 整形 ================= -->
            <TabItem Header="整形">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,14,8">
                    <StackPanel>

                        <TextBlock Text="句読点" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="RemovePunctuationCheck" Content="認識エンジンが自動で付ける句読点（、。）を取り除く"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="オンにすると、句読点は「てん」「まる」と話したときだけ入ります（日本語のみ）"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <CheckBox x:Name="AutoPeriodCheck" Content="話の区切りごとに、文末へ「。」を付ける" Margin="0,14,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="息継ぎのたびに区切られるため、文の途中に「。」が入ることがあります"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <CheckBox x:Name="QuestionCheck" Content="語尾を上げて話したときは、文末に「？」を付ける" Margin="0,14,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="声の高さから疑問文かを判断します（この PC の中で調べるだけで、どこにも送りません）。話し方によっては、付かないことや余分に付くことがあります"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="表記をそろえる" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="KanjiNumberCheck" Content="漢数字を算用数字にする（三時半 → 3時半）"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="「時」「年」「円」「人」など、数を数える言葉が続くときだけ変えます。「一緒」「一番」「数十人」などはそのままです"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <CheckBox x:Name="RemoveSpacesCheck" Content="日本語の間に入った不要な半角スペースを取り除く" Margin="0,14,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <CheckBox x:Name="RemoveFillersCheck" Content="「えーと」「あのー」などのつなぎ言葉を取り除く" Margin="0,14,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="「あの人」「その件」のような普通の言葉は消しません"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <TextBlock Text="英数字の幅" Style="{StaticResource ItemLabel}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="WidthCombo" SelectionChanged="WidthCombo_SelectionChanged"
                                  AutomationProperties.Name="英数字の幅"/>
                        <TextBlock Text="日本語で認識しているときだけ働きます。記号と、辞書に登録した表記は変えません"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= コマンド・辞書 ================= -->
            <TabItem Header="コマンド・辞書">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,14,8">
                    <StackPanel>

                        <TextBlock Text="音声コマンド" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="その言葉だけを話すと、文字の代わりに記号や操作を入力します。文の途中に出てきただけでは働きません"
                                   Style="{StaticResource SubText}" Margin="0,-4,0,12"/>

                        <CheckBox x:Name="VoiceCommandsCheck" Content="記号・句読点・改行のコマンドを使う"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <Border Style="{StaticResource FormPanel}" Margin="27,8,0,0" Padding="12,10">
                            <TextBlock Style="{StaticResource SubText}"
                                       Text="改行 ／ スペース ／ タブ&#10;まる（。） てん（、） びっくり（！） はてな（？）&#10;アットマーク（@） コロン スラッシュ ハイフン アンダーバー ドット かっこ 矢印 など&#10;音声入力を止める: 終了 ／ 音声入力終了 ／ ストップ"/>
                        </Border>

                        <CheckBox x:Name="KeyCommandsCheck" Content="キー操作のコマンドを使う" Margin="0,16,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <Border Style="{StaticResource FormPanel}" Margin="27,8,0,0" Padding="12,10">
                            <TextBlock Style="{StaticResource SubText}"
                                       Text="送信 ／ エンター（Enter）　全選択（Ctrl+A）　コピー（Ctrl+C）&#10;切り取り（Ctrl+X）　貼り付け（Ctrl+V）　一文字消す ／ バックスペース&#10;チャットで送信したいときは「送信」と話してください（「改行」は送信しません）"/>
                        </Border>

                        <TextBlock Text="英語で認識しているときは new line / period / comma / question mark、press enter / select all / copy / paste、取り消しは undo / scratch that が使えます"
                                   Style="{StaticResource SubText}" Margin="0,12,0,0"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="辞書と定型文" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="辞書は、誤って認識される言葉を正しい表記に直します。定型文は、短い読みを話すと長い文章を入力します"
                                   Style="{StaticResource SubText}" Margin="0,-4,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="辞書…" MinWidth="96" Click="OpenDictionaryButton_Click"/>
                            <Button Content="定型文…" MinWidth="96" Margin="8,0,0,0" Click="OpenSnippets_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="SnippetsCheck" Content="定型文を使う" Margin="0,14,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 認識・プライバシー ================= -->
            <TabItem Header="認識・プライバシー">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,14,8">
                    <StackPanel>

                        <TextBlock Text="認識エンジン" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="音声の認識は、裏で動かす Edge または Chrome の音声認識機能（Web Speech API）で行います"
                                   Style="{StaticResource SubText}" Margin="0,-4,0,12"/>

                        <TextBlock Text="認識に使うブラウザ" Style="{StaticResource ItemLabel}"/>
                        <ComboBox x:Name="BrowserCombo" SelectionChanged="BrowserCombo_SelectionChanged"
                                  AutomationProperties.Name="認識に使うブラウザ"/>
                        <TextBlock Text="「既定のブラウザに合わせる」では、Windows の既定が Chrome なら Chrome、それ以外は Edge を使います。変えると、その場で切り替わります"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <CheckBox x:Name="LocalRecognitionCheck" Content="できるだけ、この PC の中で認識する（音声をクラウドへ送らない）" Margin="0,16,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="新しい Edge / Chrome が必要です。対応していない場合や、言語パックがまだ入っていない場合は、自動でクラウドでの認識になります"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="記録" Style="{StaticResource SectionTitle}"/>

                        <CheckBox x:Name="LogRecognitionCheck" Content="認識した文章をログファイルに残す"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="誤認識を調べるときに役立ちますが、入力した内容そのもの（メールの下書きや顧客名など）が 30 日間ファイルに残ります。ふだんはオフのままをお勧めします"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="外部との通信" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="UpdateUrlText" Style="{StaticResource SubText}" Margin="0,-4,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 全般 ================= -->
            <TabItem Header="全般">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,18,14,8">
                    <StackPanel>

                        <TextBlock Text="起動" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="StartupCheck" Content="Windows の起動時に VoiceDock を自動で起動する"
                                  Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="更新" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="新しい版の確認" Style="{StaticResource ItemLabel}"/>
                        <ComboBox x:Name="UpdateModeCombo" SelectionChanged="UpdateModeCombo_SelectionChanged"
                                  AutomationProperties.Name="新しい版の確認"/>

                        <CheckBox x:Name="AutoUpdateCheck" Content="新しい版は、使っていないときに自動で入れ替える" Margin="0,14,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="音声入力をしておらず、VoiceDock の画面も開いておらず、PC の操作が 2 分以上無いときに入れ替えて再起動します。オフにすると、更新の画面で確認してから更新します"
                                   Style="{StaticResource SubText}" Margin="27,4,0,0"/>

                        <Button Content="今すぐ更新を確認…" HorizontalAlignment="Left" Margin="0,14,0,0"
                                Click="CheckUpdate_Click"/>

                        <Border Style="{StaticResource Divider}"/>

                        <TextBlock Text="データ" Style="{StaticResource SectionTitle}"/>

                        <TextBlock Text="保存先" Style="{StaticResource ItemLabel}"/>
                        <TextBlock x:Name="DataFolderText" Style="{StaticResource SubText}"/>
                        <Button Content="保存先を開く" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OpenDataFolder_Click"/>

                        <TextBlock Text="バックアップ" Style="{StaticResource ItemLabel}" Margin="0,18,0,6"/>
                        <WrapPanel>
                            <Button Content="バックアップを保存…" Margin="0,0,8,4" Click="SaveBackup_Click"/>
                            <Button Content="バックアップから復元…" Margin="0,0,8,4" Click="RestoreBackup_Click"/>
                        </WrapPanel>
                        <TextBlock Text="設定・辞書・定型文を 1 つのファイルにまとめます。辞書（社内の用語・人名）や定型文（住所など）が含まれるため、ファイルの受け渡しに注意してください"
                                   Style="{StaticResource SubText}" Margin="0,4,0,0"/>

                        <TextBlock Text="設定の初期化" Style="{StaticResource ItemLabel}" Margin="0,18,0,6"/>
                        <Button Content="設定を初期状態に戻す…" HorizontalAlignment="Left" Click="Reset_Click"
                                Style="{StaticResource DangerButton}"/>
                        <TextBlock Text="辞書と定型文は消えません"
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="閉じる" MinWidth="88" IsCancel="True" Click="Close_Click"/>
            <TextBlock x:Name="VersionText" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
