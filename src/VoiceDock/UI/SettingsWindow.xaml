<Window x:Class="VoiceDock.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock 設定"
        Width="440" Height="520" MinWidth="380" MinHeight="360"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <!-- タブではなく 1 本の縦リストをスクロールする形式。値の変更は即時反映（保存ボタンなし） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

            <TextBlock Text="設定" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="変更は即時に反映されます" Style="{StaticResource SubText}" Margin="0,4,0,16"/>

            <!-- ホットキー -->
            <TextBlock Text="ホットキー" FontWeight="Bold"/>
            <TextBlock Text="録音開始/停止のトグルキー。ボックスを選択してキーを押すと変更されます"
                       Style="{StaticResource SubText}" Margin="0,2,0,6"/>
            <TextBox x:Name="HotkeyBox" IsReadOnly="True" Cursor="Hand"
                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
            <TextBlock x:Name="HotkeyWarning" Foreground="{StaticResource WarnBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- 認識エンジンの説明 -->
            <TextBlock Text="音声認識" FontWeight="Bold"/>
            <TextBlock Text="認識はブラウザの Web Speech API で行います（日本語）。使用マイクは Windows の既定デバイスが使われます。音声はクラウドで認識されます。"
                       Style="{StaticResource SubText}" Margin="0,2,0,6"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- 認識用ブラウザ -->
            <TextBlock Text="認識用ブラウザ" FontWeight="Bold"/>
            <TextBlock Text="「既定のブラウザに合わせる」では、Windows の既定が Chrome なら Chrome、それ以外は Edge を使用します（Web Speech API は Chromium 系のみ対応）。変更後は再起動で反映されます。"
                       Style="{StaticResource SubText}" Margin="0,2,0,6"/>
            <ComboBox x:Name="BrowserCombo" SelectionChanged="BrowserCombo_SelectionChanged"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- 入力方式 -->
            <TextBlock Text="入力方式" FontWeight="Bold"/>
            <TextBlock Text="通常は「直接キー入力」を推奨。文字が入らないアプリでは「クリップボード貼り付け」をお試しください（元のクリップボード内容は自動復元されます）"
                       Style="{StaticResource SubText}" Margin="0,2,0,6"/>
            <ComboBox x:Name="InputMethodCombo" SelectionChanged="InputMethodCombo_SelectionChanged"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- テキスト整形 -->
            <TextBlock Text="テキスト整形" FontWeight="Bold"/>
            <TextBlock Text="認識結果の後処理を設定します" Style="{StaticResource SubText}" Margin="0,2,0,6"/>
            <CheckBox x:Name="RemoveSpacesCheck" Content="日本語の間の不要な半角スペースを除去する"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>
            <CheckBox x:Name="AutoPeriodCheck" Content="発話の区切りごとに文末へ「。」を自動挿入する" Margin="0,8,0,0"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- 音声コマンド -->
            <TextBlock Text="音声コマンド" FontWeight="Bold"/>
            <TextBlock Text="「改行」「スペース」「タブ」とだけ発話すると、その操作を入力します"
                       Style="{StaticResource SubText}" Margin="0,2,0,6"/>
            <CheckBox x:Name="VoiceCommandsCheck" Content="音声コマンドを有効にする"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- 操作音 -->
            <TextBlock Text="操作音" FontWeight="Bold"/>
            <TextBlock Text="録音の開始/停止時に短い音を鳴らします" Style="{StaticResource SubText}" Margin="0,2,0,6"/>
            <CheckBox x:Name="SoundCheck" Content="操作音を鳴らす"
                      Checked="Option_Changed" Unchecked="Option_Changed"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- スタートアップ登録 -->
            <TextBlock Text="スタートアップ登録" FontWeight="Bold"/>
            <TextBlock Text="Windows 起動時に VoiceDock を自動起動します" Style="{StaticResource SubText}" Margin="0,2,0,6"/>
            <CheckBox x:Name="StartupCheck" Content="自動起動を有効にする"
                      Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- 辞書登録（別画面への導線） -->
            <TextBlock Text="辞書登録" FontWeight="Bold"/>
            <TextBlock Text="社内用語・人名などの誤認識対策ワードは辞書管理画面から登録します"
                       Style="{StaticResource SubText}" Margin="0,2,0,6"/>
            <Button x:Name="OpenDictionaryButton" Content="辞書管理を開く"
                    HorizontalAlignment="Left" Click="OpenDictionaryButton_Click"/>

            <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

            <!-- バージョン情報 -->
            <TextBlock x:Name="VersionText" Style="{StaticResource SubText}" Margin="0,0,0,8"/>

        </StackPanel>
    </ScrollViewer>
</Window>
