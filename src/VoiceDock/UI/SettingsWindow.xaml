<Window x:Class="VoiceDock.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock 設定"
        Width="520" Height="580" MinWidth="460" MinHeight="420"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <!-- 項目が多いためタブで分ける。値の変更は即時反映（保存ボタンなし） -->
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="設定" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="変更は即時に反映されます" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- ================= 基本 ================= -->
            <TabItem Header="基本">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,14,12,4">
                    <StackPanel>

                        <TextBlock Text="ホットキー" FontWeight="Bold"/>
                        <TextBlock Text="音声入力の開始/停止に使うキーです。下の欄をクリックしてから、使いたいキーを押してください"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <TextBox x:Name="HotkeyBox" IsReadOnly="True" Cursor="Hand"
                                 ToolTip="ここをクリックしてから、割り当てたいキーを押してください"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <TextBlock x:Name="HotkeyWarning" Foreground="{StaticResource WarnBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                        <TextBlock Text="操作方式" Margin="0,12,0,0"/>
                        <TextBlock Text="「押している間だけ」は、キーを押している間だけ音声入力します。短い一言を挟む用途では誤操作が減ります"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <ComboBox x:Name="HotkeyModeCombo" SelectionChanged="HotkeyModeCombo_SelectionChanged"/>

                        <TextBlock Text="無音で自動停止するまでの時間" Margin="0,12,0,0"/>
                        <TextBlock Text="話さない状態がこの時間続くと、音声入力を自動で止めます。止め忘れて周りの会話を拾わないための機能です"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <ComboBox x:Name="SilenceCombo" SelectionChanged="SilenceCombo_SelectionChanged"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="直前の入力を取り消す" FontWeight="Bold"/>
                        <TextBlock Text="誤認識をやり直すための機能です。「とりけし」と発話するか、下のホットキーで、直前に入力した分だけ削除します"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="UndoCheck" Content="取り消しを有効にする"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBox x:Name="UndoHotkeyBox" IsReadOnly="True" Cursor="Hand" Margin="0,8,0,0"
                                 ToolTip="ここをクリックしてから、割り当てたいキーを押してください"
                                 PreviewKeyDown="UndoHotkeyBox_PreviewKeyDown"/>
                        <TextBlock x:Name="UndoHotkeyWarning" Foreground="{StaticResource WarnBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="操作音" FontWeight="Bold"/>
                        <TextBlock Text="音声入力の開始/停止時に短い音を鳴らします" Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="SoundCheck" Content="操作音を鳴らす"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="スタートアップ登録" FontWeight="Bold"/>
                        <TextBlock Text="Windows 起動時に VoiceDock を自動起動します" Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="StartupCheck" Content="自動起動を有効にする"
                                  Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 入力 ================= -->
            <TabItem Header="入力">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,14,12,4">
                    <StackPanel>

                        <TextBlock Text="入力方式" FontWeight="Bold"/>
                        <TextBlock Text="通常は「直接キー入力」を推奨します。文字が入らないアプリでは「クリップボード貼り付け」をお試しください（元のクリップボード内容は自動で戻ります）"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <ComboBox x:Name="InputMethodCombo" SelectionChanged="InputMethodCombo_SelectionChanged"/>

                        <TextBlock Text="特定のアプリだけ、入力方式や「改行」の送り方を変えることもできます"
                                   Style="{StaticResource SubText}" Margin="0,8,0,6"/>
                        <Button Content="アプリ別の設定" HorizontalAlignment="Left" Click="OpenAppRules_Click"/>

                        <TextBlock Text="「改行」の送り方" Margin="0,14,0,0"/>
                        <TextBlock Text="Shift+Enter はメモ帳やエディタを含む大半のアプリで改行になり、Enter が「送信」になるチャットアプリ（Claude Desktop・Slack・Teams 等）でも誤送信しません。Excel のセル内改行のようにアプリによって変えたい場合は、上の「アプリ別の設定」で指定できます"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <ComboBox x:Name="NewlineCombo" SelectionChanged="NewlineCombo_SelectionChanged"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="テキスト整形" FontWeight="Bold"/>
                        <TextBlock Text="認識結果の後処理を設定します" Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="RemoveSpacesCheck" Content="日本語の間の不要な半角スペースを除去する"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <CheckBox x:Name="AutoPeriodCheck" Content="発話の区切りごとに文末へ「。」を自動挿入する" Margin="0,8,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="※ 息継ぎのたびに区切られるため、文の途中に「。」が入ることがあります。句読点は音声コマンド（「まる」「てん」）での入力を推奨します"
                                   Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                        <CheckBox x:Name="RemoveFillersCheck" Content="「えーと」「あのー」などのつなぎ言葉を取り除く" Margin="0,10,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                        <TextBlock Text="文頭や読点の後にある「えーと」「えっと」「あのー」「そのー」「うーん」などを取り除きます。「あの人」「その件」のような普通の言葉は消しません"
                                   Style="{StaticResource SubText}" Margin="0,4,0,0"/>

                        <TextBlock Text="英数字の幅" Margin="0,12,0,0"/>
                        <TextBlock Text="認識結果の数字とアルファベットを、半角か全角にそろえます（日本語で認識しているときのみ。記号と、辞書で登録した表記は変えません）"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <ComboBox x:Name="WidthCombo" SelectionChanged="WidthCombo_SelectionChanged"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 音声・辞書 ================= -->
            <TabItem Header="音声・辞書">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,14,12,4">
                    <StackPanel>

                        <TextBlock Text="音声コマンド" FontWeight="Bold"/>
                        <TextBlock Text="その語だけを発話すると、対応する文字や操作を入力します。文中に含まれるだけでは反応しません。&#10;・操作: 改行 / スペース / タブ&#10;・句読点: まる（。） てん（、） びっくり（！） はてな（？）&#10;・記号: アットマーク（@） コロン スラッシュ ハイフン アンダーバー ドット かっこ 矢印 など"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="VoiceCommandsCheck" Content="音声コマンド（句読点・記号を含む）を有効にする"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <TextBlock Text="キー操作の音声コマンド" Margin="0,12,0,0"/>
                        <TextBlock Text="その語だけを発話すると、キー操作を送ります。「改行」は Shift+Enter のため、チャットで送信したいときは「送信」と話してください。&#10;・送信 / エンター（Enter）　・全選択（Ctrl+A）　・コピー（Ctrl+C）&#10;・切り取り（Ctrl+X）　・貼り付け（Ctrl+V）　・一文字消す / バックスペース（BackSpace）&#10;英語で認識しているときは press enter / send / select all / copy / cut / paste / backspace"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="KeyCommandsCheck" Content="キー操作の音声コマンドを有効にする"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="辞書と定型文" FontWeight="Bold"/>
                        <TextBlock Text="辞書は「文中の誤認識を正しい語に直す」もの、定型文は「読みを発話して長文に展開する」ものです"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="辞書管理を開く" Click="OpenDictionaryButton_Click"/>
                            <Button Content="定型文を編集" Margin="8,0,0,0" Click="OpenSnippets_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="SnippetsCheck" Content="定型文を有効にする" Margin="0,10,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="認識言語" FontWeight="Bold"/>
                        <TextBlock Text="話す言語を選びます。トレイメニューの「認識言語」からも切り替えられ、音声入力中に変えてもその場で切り替わります"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged"/>
                        <TextBlock Text="英語では、区切りごとの認識結果の間にスペースを自動で入れます。音声コマンドは「new line」「new paragraph」「period」「comma」「question mark」、取り消しは「undo」「scratch that」が使えます"
                                   Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="認識エンジン" FontWeight="Bold"/>
                        <TextBlock Text="認識はブラウザの Web Speech API で行います（日本語）"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <ComboBox x:Name="BrowserCombo" SelectionChanged="BrowserCombo_SelectionChanged"/>
                        <TextBlock Text="「既定のブラウザに合わせる」では、Windows の既定が Chrome なら Chrome、それ以外は Edge を使用します。変更するとその場で切り替わります"
                                   Style="{StaticResource SubText}" Margin="0,4,0,0"/>

                        <TextBlock Text="マイク" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBlock x:Name="MicrophoneText" Style="{StaticResource SubText}" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="音声認識は常に Windows の既定の録音デバイスを使います（Web Speech API にマイクを指定する手段が無いため、ここでは選べません）。変更するときは Windows の 設定 → システム → サウンド → 入力 で切り替えてください。録音中に切り替えた場合も追随します"
                                   Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= プライバシー・更新 ================= -->
            <TabItem Header="プライバシー・更新">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,14,12,4">
                    <StackPanel>

                        <TextBlock Text="端末内で認識する" FontWeight="Bold"/>
                        <TextBlock Text="対応ブラウザでは音声をクラウドに送らず、端末内だけで認識します。非対応の場合や日本語の言語パックが未導入の場合は、自動でクラウド認識に切り替わります（新しめの Edge / Chrome が必要です）"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="LocalRecognitionCheck" Content="可能なら端末内で認識する"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="認識テキストの記録" FontWeight="Bold"/>
                        <TextBlock Text="有効にすると、入力した内容そのものがログファイルに 30 日間残ります。誤認識の調査に役立ちますが、メールの下書きや顧客名なども平文で保存される点にご注意ください"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <CheckBox x:Name="LogRecognitionCheck" Content="認識したテキストをログファイルに保存する"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="更新" FontWeight="Bold"/>
                        <TextBlock x:Name="UpdateUrlText" Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <ComboBox x:Name="UpdateModeCombo" SelectionChanged="UpdateModeCombo_SelectionChanged"/>
                        <Button Content="今すぐ更新を確認" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Click="CheckUpdate_Click"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="バックアップ" FontWeight="Bold"/>
                        <TextBlock Text="設定・辞書・定型文をまとめて 1 つのファイルに保存し、別の PC や再インストール後に復元できます"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <WrapPanel>
                            <Button Content="バックアップを保存" Margin="0,0,8,4" Click="SaveBackup_Click"/>
                            <Button Content="バックアップから復元" Margin="0,0,8,4" Click="RestoreBackup_Click"/>
                        </WrapPanel>
                        <TextBlock Text="保存したファイルには辞書（社内用語・人名）や定型文（住所など）が含まれます。保存先や受け渡しの方法に注意してください"
                                   Style="{StaticResource SubText}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                        <Separator Margin="0,16" Background="{StaticResource BorderBrush}"/>

                        <TextBlock Text="設定の初期化" FontWeight="Bold"/>
                        <TextBlock Text="すべての設定を初期状態に戻します。辞書と定型文は削除されません"
                                   Style="{StaticResource SubText}" Margin="0,2,0,6"/>
                        <Button Content="設定を初期状態に戻す" HorizontalAlignment="Left" Click="Reset_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <TextBlock Grid.Row="2" x:Name="VersionText" Style="{StaticResource SubText}" Margin="0,12,0,0"/>
    </Grid>
</Window>
