<Window x:Class="VoiceDock.UI.SnippetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VoiceDock.UI"
        Title="VoiceDock の定型文"
        Width="680" Height="680" MinWidth="520" MinHeight="520"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <ui:OneLineConverter x:Key="OneLine"/>
    </Window.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="定型文" Style="{StaticResource PageTitle}"/>
        <StackPanel Grid.Row="1" Margin="0,4,0,14">
            <TextBlock Style="{StaticResource SubText}"
                       Text="「読み」だけを話すと、登録した本文を入力します（例:「住所」→ 会社の住所）。話した言葉の全体が読みと一致したときだけ働きます。読みは、実際に認識される表記で登録してください（「じゅうしょ」と話して「住所」と認識されるなら「住所」）。"/>
            <TextBlock x:Name="DisabledWarning" Style="{StaticResource WarnText}" Margin="0,6,0,0" Visibility="Collapsed"
                       Text="いまは定型文がオフになっています。使うには、設定の「コマンド・辞書」で「定型文を使う」をオンにしてください。"/>
        </StackPanel>

        <!-- 登録フォーム -->
        <Border Grid.Row="2" Style="{StaticResource FormPanel}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="読み（例: 住所 ／ 署名 ／ メールアドレス）" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PhraseBox" AutomationProperties.Name="読み"/>

                <TextBlock Text="入力する本文（Enter で改行、Ctrl+Enter で登録）" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <!-- Tab は次の欄へ移るために使う（本文に Tab を入れられるようにすると、キーボードでこの欄から出られなくなる） -->
                <TextBox x:Name="ExpansionBox" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         AutomationProperties.Name="入力する本文"/>

                <DockPanel Margin="0,12,0,0" LastChildFill="True">
                    <Button x:Name="PrimaryButton" Content="追加" Style="{StaticResource PrimaryButton}"
                            Click="Primary_Click" ToolTip="Ctrl+Enter でも実行できます"/>
                    <Button Content="入力欄を空にする" Margin="8,0,0,0" Click="New_Click"
                            ToolTip="入力欄を空にして、新しく登録する状態に戻します"/>
                    <Button x:Name="UndoDeleteButton" DockPanel.Dock="Right" Content="元に戻す" Margin="8,0,0,0"
                            Style="{StaticResource LinkButton}" VerticalAlignment="Center" Visibility="Collapsed"
                            Click="UndoDelete_Click" ToolTip="いま削除した項目を元に戻します"/>
                    <TextBlock x:Name="FormStatus" Style="{StaticResource SubText}" Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 検索 -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="検索" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource SubFgBrush}"/>
            <TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                     AutomationProperties.Name="検索"
                     ToolTip="読み・本文のどちらでも探せます（Ctrl+F）"/>
            <TextBlock Grid.Column="2" x:Name="CountText" Style="{StaticResource SubText}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <!-- 一覧（編集は上のフォームで行う） -->
        <Grid Grid.Row="4">
            <DataGrid x:Name="Grid"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False"
                      SelectionUnit="FullRow" SelectionMode="Extended"
                      SelectionChanged="Grid_SelectionChanged"
                      Background="{StaticResource PanelBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="読み" Binding="{Binding Phrase}" Width="180"/>
                    <DataGridTextColumn Header="入力する本文"
                                        Binding="{Binding Expansion, Converter={StaticResource OneLine}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                       TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <WrapPanel Grid.Row="5" Margin="0,10,0,0">
            <Button x:Name="DeleteButton" Content="選んだ項目を削除" Margin="0,0,8,4" Click="DeleteRows_Click"
                    Style="{StaticResource DangerButton}" IsEnabled="False"
                    ToolTip="Delete キーでも削除できます"/>
            <Button Content="CSV に書き出す…" Margin="0,0,8,4" Click="Export_Click"
                    ToolTip="書き出したファイルには、住所などの個人情報が含まれることがあります。取り扱いに注意してください"/>
            <Button Content="CSV から読み込む…" Margin="0,0,8,4" Click="Import_Click"/>
        </WrapPanel>
    </Grid>
</Window>
