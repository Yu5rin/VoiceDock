<Window x:Class="VoiceDock.UI.SnippetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:VoiceDock.UI"
        Title="VoiceDock 定型文"
        Width="660" Height="660" MinWidth="500" MinHeight="500"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <ui:OneLineConverter x:Key="OneLine"/>
    </Window.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="定型文" FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" Style="{StaticResource SubText}" Margin="0,4,0,12"
                   Text="「読み」だけを発話すると、登録した本文を入力します（例:「住所」→ 会社の住所全文）。誤爆を防ぐため、発話全体が読みと一致したときだけ働きます。読みは実際に認識される表記で登録してください。たとえば「じゅうしょ」と話して「住所」と認識されるなら、「住所」と登録します。"/>

        <!-- 登録フォーム -->
        <Border Grid.Row="2" Style="{StaticResource FormPanel}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="読み（発話）" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PhraseBox" ToolTip="例: 住所 / 署名 / メールアドレス"/>

                <TextBlock Text="入力する本文（改行できます）" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                <TextBox x:Name="ExpansionBox" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         ToolTip="Ctrl+Enter で登録できます"/>

                <DockPanel Margin="0,10,0,0" LastChildFill="True">
                    <Button x:Name="PrimaryButton" Content="追加" Style="{StaticResource PrimaryButton}"
                            Click="Primary_Click" ToolTip="Ctrl+Enter でも実行できます"/>
                    <Button Content="新規入力" Margin="8,0,0,0" Click="New_Click"
                            ToolTip="入力欄を空にして、新しく登録する状態に戻します"/>
                    <TextBlock x:Name="FormStatus" Style="{StaticResource SubText}" Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 検索 -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="検索" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource SubFgBrush}"/>
            <TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                     ToolTip="読み・本文のどちらでも探せます（Ctrl+F）"/>
            <TextBlock Grid.Column="2" x:Name="CountText" Style="{StaticResource SubText}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>

        <!-- 一覧（編集は上のフォームで行う） -->
        <Grid Grid.Row="4">
            <DataGrid x:Name="Grid"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      IsReadOnly="True" CanUserSortColumns="True" CanUserReorderColumns="False"
                      SelectionUnit="FullRow" SelectionMode="Extended"
                      SelectionChanged="Grid_SelectionChanged"
                      Background="{StaticResource PanelBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="読み（発話）" Binding="{Binding Phrase}" Width="180"/>
                    <DataGridTextColumn Header="入力する本文"
                                        Binding="{Binding Expansion, Converter={StaticResource OneLine}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Style="{StaticResource SubText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0"
                       TextAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <WrapPanel Grid.Row="5" Margin="0,10,0,0">
            <Button Content="選択した項目を削除" Margin="0,0,8,4" Click="DeleteRows_Click"
                    ToolTip="Delete キーでも削除できます"/>
            <Button Content="CSV に書き出す" Margin="0,0,8,4" Click="Export_Click"/>
            <Button Content="CSV から読み込む" Margin="0,0,8,4" Click="Import_Click"/>
        </WrapPanel>
    </Grid>
</Window>
