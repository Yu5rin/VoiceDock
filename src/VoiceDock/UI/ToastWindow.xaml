<Window x:Class="VoiceDock.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock Toast"
        SizeToContent="WidthAndHeight" MaxWidth="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" ResizeMode="NoResize" Opacity="0"
        FontFamily="Yu Gothic UI, Yu Gothic, Meiryo UI, sans-serif" FontSize="13">
    <!-- ミニマルデザインに合わせた自作トースト通知（バルーン通知は使わない） -->
    <Border CornerRadius="8" Background="{DynamicResource ToastBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" x:Name="AccentBar" Width="3" Background="{DynamicResource SubFgBrush}"
                    CornerRadius="1.5" Margin="10,12,0,12"/>
            <StackPanel Grid.Column="1" Margin="12,12,16,12">
                <TextBlock x:Name="TitleText" Foreground="{DynamicResource FgBrush}" FontWeight="Bold" Text="VoiceDock"/>
                <TextBlock x:Name="MessageText" Foreground="{DynamicResource SubFgBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
