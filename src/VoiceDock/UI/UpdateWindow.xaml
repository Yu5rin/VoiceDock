<Window x:Class="VoiceDock.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock の更新"
        Width="520" Height="440" MinWidth="420" MinHeight="320"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="新しいバージョンがあります"
                   FontSize="18" FontWeight="Bold"/>
        <TextBlock Grid.Row="1" x:Name="VersionText" Style="{StaticResource SubText}" Margin="0,6,0,12"/>

        <!-- リリースノート -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12"/>
            </ScrollViewer>
        </Border>

        <!-- 進捗 -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource SubText}" Visibility="Collapsed"/>
            <ProgressBar x:Name="Progress" Height="6" Margin="0,6,0,0"
                         Background="{StaticResource ControlBrush}"
                         Foreground="{StaticResource AccentBrush}"
                         BorderThickness="0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="この版はスキップ" Click="Skip_Click"/>
            <Button x:Name="ReleasePageButton" Content="リリースページを開く" Margin="8,0,0,0" Click="ReleasePage_Click"/>
            <Button x:Name="UpdateButton" Content="今すぐ更新" Margin="8,0,0,0" Click="Update_Click"/>
            <Button x:Name="CloseButton" Content="あとで" Margin="8,0,0,0" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
