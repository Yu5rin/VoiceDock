<Window x:Class="VoiceDock.UI.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceDock の更新"
        Width="580" Height="480" MinWidth="460" MinHeight="360"
        Style="{StaticResource WindowStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" Text="新しい版があります"
                   Style="{StaticResource PageTitle}"/>
        <TextBlock Grid.Row="1" x:Name="VersionText" Style="{StaticResource SubText}" Margin="0,6,0,14"/>

        <!-- リリースノート -->
        <!-- 変更点。文字を選んでコピーできるよう、読み取り専用の入力欄で表示する -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <TextBox x:Name="NotesText" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                     Padding="12,10" AutomationProperties.Name="変更点"/>
        </Border>

        <!-- 進捗 -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource SubText}" Visibility="Collapsed"/>
            <ProgressBar x:Name="Progress" Margin="0,6,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- 幅を狭めるとボタンが押し出されて隠れてしまうため、折り返して並べる -->
        <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Content="この版は入れない" Margin="8,4,0,0" Click="Skip_Click"
                    ToolTip="この版のお知らせを、今後は出さないようにします。次の版が出たら、またお知らせします"/>
            <Button x:Name="ReleasePageButton" Content="配布ページを開く" Margin="8,4,0,0" Click="ReleasePage_Click"
                    ToolTip="GitHub の配布ページをブラウザで開きます"/>
            <Button x:Name="UpdateButton" Content="今すぐ更新" Margin="8,4,0,0" Click="Update_Click"
                    Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            <Button x:Name="CloseButton" Content="あとで" MinWidth="88" Margin="8,4,0,0" Click="Close_Click" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
