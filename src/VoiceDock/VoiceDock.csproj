<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>VoiceDock</RootNamespace>
    <AssemblyName>VoiceDock</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      exe・タスクバー・ウィンドウのアイコン。タスクトレイアイコン (UI/IconFactory.cs) と
      同じマイク意匠で、tools/generate_app_icon.py により生成する。
    -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Linux 等の非 Windows 環境でも win 向けビルドを可能にする -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.7.6</Version>
    <Product>VoiceDock</Product>
    <Description>Web Speech API を用いた音声入力ツール</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms の暗黙 global using は WPF の型 (Application/Brush 等) と衝突するため外す -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!--
    認識エンジンは Web Speech API（ブラウザ側）に移行したため、
    ローカル音声認識ライブラリ（Whisper.net）およびマイク録音ライブラリ（NAudio）は不要。
    録音・認識はブラウザが行い、本体は WebSocket で結果を受け取って SendInput で流し込む。
  -->

</Project>
